# Generated build directories (CMake, CubeIDE and CLion)
/build/
/Debug/
/Release/
/cmake-build-*/

# CMake/Ninja files generated by an in-source build
/CMakeFiles/
/CMakeCache.txt
/compile_commands.json
/cmake_install.cmake
/build.ninja
/.ninja_deps
/.ninja_log

# Compiler/linker outputs; keep Static/**/*.bin (runtime image assets)
*.o
*.obj
*.d
*.su
*.map
*.elf
*.axf

# CubeMX scratch files and local editor caches
mx.scratch
/.cache/
/.clangd/
/.idea/workspace.xml
/.idea/shelf/
/.idea/httpRequests/
/.idea/dataSources/
/.idea/dataSources.local.xml

# Temporary/editor and operating-system files
*.tmp
*.temp
*.swp
*.swo
*~
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db

# Keep shared STM32 IDE configuration
!.settings/
